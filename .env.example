# Template for .env. This file is committed; your .env is not.
#
#   make env    creates .env from this file with a generated JWT_SECRET
#
# No `export` prefix, no spaces around `=`, no quotes.

# ---- API --------------------------------------------------------------------

# Port the server listens on inside the container.
PORT=8080

# Port published on your host. Change if 8080 is already taken.
API_PORT=8080

# "development" or "production". Production switches Gin to release mode.
ENV=development

# Signing key for JWTs. Required — the API refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32

# ---- Postgres ---------------------------------------------------------------
# Read only on first start, while the data directory is initialised. Run
# `make reset` to apply changes to these three.

POSTGRES_USER=hiredesk
POSTGRES_PASSWORD=hiredesk_dev_password
POSTGRES_DB=hiredesk

# Host port for the database. Set to 5433 if you already run Postgres locally.
POSTGRES_PORT=5432

# DATABASE_URL is not set here: docker-compose.yml assembles it from the
# POSTGRES_* values above, using the hostname "postgres".
#
# Only needed when running the API directly on your host, where it is:
#   export DATABASE_URL="postgres://hiredesk:hiredesk_dev_password@localhost:5432/hiredesk?sslmode=disable"
