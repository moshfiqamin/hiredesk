# Template for .env. This file is committed; your .env is not.
#
#   make env    creates .env from this file with a generated JWT_SECRET
#
# No `export` prefix, no spaces around `=`, no quotes.
#
# Every variable here has a default in docker-compose.yml, so an older .env
# missing the newer entries still starts — it just uses those defaults.

# ---- API --------------------------------------------------------------------

# Port the server listens on inside the container.
PORT=8080

# Port published on your host. Change if 8080 is already taken.
API_PORT=8080

# "development" or "production". Production switches Gin to release mode.
ENV=development

# Signing key for JWTs. Required — the API refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32

# ---- Postgres ---------------------------------------------------------------
# Read only on first start, while the data directory is initialised. Run
# `make reset` to apply changes to these three.

POSTGRES_USER=hiredesk
POSTGRES_PASSWORD=hiredesk_dev_password
POSTGRES_DB=hiredesk

# Host port for the database. The container always listens on 5432; this only
# controls where it is published on your machine.
#
# Set it to 5433 if you already run Postgres locally. A local Postgres bound to
# 127.0.0.1:5432 WINS over Docker's 0.0.0.0 binding, so `localhost:5432` would
# reach that one instead of this container and fail with
# `role "hiredesk" does not exist`. Changing this needs only
# `make down && make up` — it is not one of the three init-only variables.
POSTGRES_PORT=5432

# ---- Connection pool --------------------------------------------------------
# Set explicitly rather than left to pgx's defaults, which derive MaxConns from
# the CPU count of whichever machine the container lands on. Durations use Go
# syntax ("30s", "1h30m"); a bare number is rejected at startup as ambiguous.

# Hard ceiling on connections this API instance may hold. Budget it so that
# (instances x DB_MAX_CONNS) + room for psql <= Postgres max_connections,
# which is 100 by default. Too low throttles throughput under load; too high
# exhausts the server's slots and leaves nothing for an admin connection.
DB_MAX_CONNS=10

# Idle connections kept open even when the API is quiet, so the first request
# after a lull does not pay for TCP, TLS and Postgres authentication. Refused
# at startup if it exceeds DB_MAX_CONNS.
DB_MIN_CONNS=2

# Maximum age of any single connection, however healthy. Bounds the lifetime of
# a leaked server-side session and lets connections move after a failover.
DB_MAX_CONN_LIFETIME=1h

# An idle connection unused for longer than this is closed, returning memory
# on the database server.
DB_MAX_CONN_IDLE_TIME=30m

# Budget for the one-off ping at startup. Exceeding it stops the process, so a
# wrong DATABASE_URL fails visibly at boot rather than on the first request.
DB_CONNECT_TIMEOUT=5s

# Budget for the /readyz ping. Keep it below your load balancer's own probe
# timeout, so the handler answers before the probe gives up on it.
DB_PING_TIMEOUT=2s

# ---- Shutdown ---------------------------------------------------------------

# How long the server waits for in-flight requests after SIGTERM before
# closing anyway. Keep it below the compose stop_grace_period of 15s, or
# Docker's SIGKILL arrives in the middle of the drain.
SHUTDOWN_TIMEOUT=10s

# ---- Adminer ----------------------------------------------------------------

# The database browser, at http://localhost:<ADMINER_PORT>. Published on
# 127.0.0.1 only: it is a development tool and must never be exposed.
ADMINER_PORT=8081

# -----------------------------------------------------------------------------
# DATABASE_URL is NOT set here: docker-compose.yml assembles it from the
# POSTGRES_* values above, using the hostname "postgres" (the service name)
# rather than localhost, because that is how one container reaches another.
#
# You only need to set it yourself when running the API directly on your host
# with `go run ./cmd/api`, where the database is reachable at localhost:
#
#   export DATABASE_URL="postgres://hiredesk:hiredesk_dev_password@localhost:5432/hiredesk?sslmode=disable"
#
# (use the POSTGRES_PORT you set above, not 5432, if you changed it)
# -----------------------------------------------------------------------------
